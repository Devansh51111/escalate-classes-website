APP_ENV=local
APP_URL=http://localhost/escalate-classes/public
APP_TIMEZONE=Asia/Kolkata
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=escalate_classes
DB_USER=
DB_PASSWORD=
SESSION_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENCRYPTION=tls
RESET_EXPIRY_MINUTES=30
MAX_UPLOAD_BYTES=5242880
# Set false on hosts that forbid stored backups: backups are then download-only and never kept on the server.
BACKUP_STORE=true
